# AA Engineering Toolkit matplotlib style (colours from branding/theme.json)
# Use in a notebook:  plt.style.use("../branding/aa.mplstyle")

axes.prop_cycle : cycler('color', ['E0A800', '2B2D31', '3D7EA6', 'C8632B', '3E9A5C', '7A64A8', '8A8D93', '9A7400'])
axes.facecolor  : FFFFFF
axes.edgecolor  : CFD1D6
axes.labelcolor : 111214
axes.titlesize  : 13
axes.titleweight: semibold
axes.labelsize  : 11
axes.grid       : True
axes.spines.top : False
axes.spines.right : False

grid.color      : E6E7EA
grid.linestyle  : -
grid.linewidth  : 0.8

lines.linewidth : 2.2
lines.markersize: 6

xtick.color     : 5E6168
ytick.color     : 5E6168
text.color      : 111214

figure.facecolor: FFFFFF
figure.dpi      : 110
figure.autolayout : True

legend.frameon  : False
font.family     : sans-serif
font.sans-serif : Inter, Segoe UI, DejaVu Sans, Arial
